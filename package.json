{
  "name": "sharenet-backend",
  "version": "1.0.0",
  "description": "Sharenet Workshop Booking Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "dev": "nodemon --experimental-specifier-resolution=node --exec node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["sharenet", "workshop", "booking"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.11.30",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}